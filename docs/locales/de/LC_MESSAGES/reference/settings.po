msgstr "DEFAULT_DEPOTLIST_GENERATORS"

#: ../../reference/settings.rst:626 49317beda0264d4f8d40299f6404d2fb
msgid ""
"Deprecated since version 2.0. :ref:`Use DEPOT_LISTS instead <settings-"
"depot-lists>`."
msgstr ""
"Seit Version 2.0 veraltet. :ref:`Verwende stattdessen DEPOT_LISTS "
"<settings-depot-lists>`."

#: ../../reference/settings.rst:629 77bb1f54a42c426ab583f700ff69e443
msgid ""
"Changed in version 2.0: Takes ``context`` as argument instead of ``*args,"
" **options``."
msgstr ""
"Geändert in Version 2.0: Nimmt ``context`` als Argument statt ``*args, "
"**options``."


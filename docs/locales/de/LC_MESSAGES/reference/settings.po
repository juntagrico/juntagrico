msgid "DEPOT_LIST_GENERATION_DAYS"
msgstr "DEPOT_LIST_GENERATION_DAYS"

#: ../../reference/settings.rst:609 932984369d7949a0b52e7c53be1fd8e3
msgid "Days on which the delivery list can be generated"
msgstr "Tage, an denen die Lieferliste erstellt werden kann"

#: ../../reference/settings.rst:611 36321be0ec9b4029b6fbc6489c3a139c
msgid ""
"Type: List of Integers representing days of the week, where Monday is 0 "
"and Sunday is 6."
msgstr ""
"Typ: Liste von Integers, die Wochentage repräsentieren, wobei Montag 0 "
"und Sonntag 6 ist."

#: ../../reference/settings.rst:624 c828c4a93b5b43bd973c0107eda1dd36

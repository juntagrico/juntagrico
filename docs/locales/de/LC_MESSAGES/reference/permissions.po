msgid "juntagrico.notified_on_share_cancellation"
msgstr "juntagrico.notified_on_share_cancellation"

#: ../../reference/permissions.rst:163 8979e136d79b4294a6d2a78ce8bd36d5
msgid ""
"Person gets :ref:`notified <reference-notifications-share-canceled>` when"
" a share is canceled."
msgstr ""
"Person wird :ref:`benachrichtigt <reference-notifications-share-"
"canceled>`, wenn eine Aktie gekündigt wird."

#: ../../reference/permissions.rst:166 ../../reference/permissions.rst:184
